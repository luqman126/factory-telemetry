{
  "title": "IoT Manufacturing Monitor",
  "uid": "iot-manufacturing-v1",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Temperature per Ruangan",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT time, temperature, device_id || ' - ' || location AS device FROM sensor_readings WHERE $__timeFilter(time) AND temperature IS NOT NULL ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 2,
      "title": "Humidity per Ruangan",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT time, humidity, device_id || ' - ' || location AS device FROM sensor_readings WHERE $__timeFilter(time) AND humidity IS NOT NULL ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 2 }
        }
      }
    },
    {
      "id": 3,
      "title": "Kadar Uap Flux (ppm) - Ruang Penyolderan",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT time, flux_ppm, location FROM sensor_readings WHERE $__timeFilter(time) AND flux_ppm IS NOT NULL ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 35 },
              { "color": "red", "value": 75 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Vibration RMS - Ruang Produksi",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT time, vibration_rms, location FROM sensor_readings WHERE $__timeFilter(time) AND vibration_rms IS NOT NULL ORDER BY time",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "accMS2",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Anomali Terdeteksi (1 jam terakhir)",
      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": "TimescaleDB",
      "targets": [
        {
          "rawSql": "SELECT event_time AS \"Waktu\", device_id AS \"Device\", location AS \"Lokasi\", sensor_type AS \"Sensor\", observed_value AS \"Nilai\", threshold_value AS \"Threshold\", severity AS \"Severity\" FROM anomaly_events WHERE event_time >= NOW() - INTERVAL '1 hour' ORDER BY event_time DESC LIMIT 50",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}