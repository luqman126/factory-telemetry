apiVersion: 1

contactPoints:
  - orgId: 1
    name: telegram-alert-iot
    receivers:
      - uid: telegram-iot
        type: telegram
        settings:
          bottoken: "${TELEGRAM_BOT_TOKEN_IOT}"
          chatid: ${TELEGRAM_CHAT_ID_IOT}
          parse_mode: "HTML"
          disable_web_page_preview: true
          protect_content: false
          message: |
            {{- if eq .Status "firing" -}}
            🚨 <b>[IoT Alert] {{ .CommonLabels.severity | toUpper }}</b> — {{ .CommonLabels.alertname }}

            {{ range .Alerts -}}
            <b>{{ .Annotations.summary }}</b>
            {{ .Annotations.description }}

            🕐 Started: {{ .StartsAt.Format "2006-01-02 15:04:05" }} UTC
            {{ end -}}
            {{- else -}}
            ✅ <b>[IoT Alert] RESOLVED</b> — {{ .CommonLabels.alertname }}

            {{ range .Alerts -}}
            🕐 Started:  {{ .StartsAt.Format "2006-01-02 15:04:05" }} UTC
            🕐 Resolved: {{ .EndsAt.Format "2006-01-02 15:04:05" }} UTC
            {{ end -}}
            {{- end -}}

  - orgId: 1
    name: telegram-alert-server
    receivers:
      - uid: telegram-server
        type: telegram
        settings:
          bottoken: "${TELEGRAM_BOT_TOKEN_SERVER}"
          chatid: ${TELEGRAM_CHAT_ID_SERVER}
          parse_mode: "HTML"
          disable_web_page_preview: true
          protect_content: false
          message: |
            {{- if eq .Status "firing" -}}
            🖥️ <b>[Server Alert] {{ .CommonLabels.severity | toUpper }}</b> — {{ .CommonLabels.alertname }}

            {{ range .Alerts -}}
            <b>{{ .Annotations.summary }}</b>
            {{ .Annotations.description }}

            🕐 Started: {{ .StartsAt.Format "2006-01-02 15:04:05" }} UTC
            {{ end -}}
            {{- else -}}
            ✅ <b>[Server Alert] RESOLVED</b> — {{ .CommonLabels.alertname }}

            {{ range .Alerts -}}
            🕐 Started:  {{ .StartsAt.Format "2006-01-02 15:04:05" }} UTC
            🕐 Resolved: {{ .EndsAt.Format "2006-01-02 15:04:05" }} UTC
            {{ end -}}
            {{- end -}}
