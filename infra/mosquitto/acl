# ============================================================
# ACL (Access Control List) for Mosquitto Broker
# ============================================================

# Backend / consumer user (Full Access to IoT topics)
user kagebyo
topic readwrite iot/#

# Dynamic client rules for individual physical IoT Devices
# %u matches the connecting client's username (e.g., device_001)
pattern write iot/sensor/%u/+
pattern read iot/commands/%u/+
