# Local .terraform directory (plugins, modules, providers)
.terraform/

# Terraform state files (local state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variable files that might contain secrets
# (except staging.tfvars and example files which are safe to commit)
*.tfvars
!environments/staging.tfvars
!secrets.auto.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Plan file
*.tfplan