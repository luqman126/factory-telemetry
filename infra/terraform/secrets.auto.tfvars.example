# ============================================================
# secrets.auto.tfvars.example
# CONTOH file secrets — copy ke secrets.auto.tfvars dan isi nilai sesungguhnya
# File secrets.auto.tfvars sudah di-gitignore, aman dari git tracking
#
# Cara pakai:
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#   nano secrets.auto.tfvars  # isi dengan nilai asli
# ============================================================

# Database
db_name     = "staging_iot_db"
db_user     = "your_db_user_here"
db_password = "your_db_password_here"

# MQTT Broker
mqtt_user     = "your_mqtt_user_here"
mqtt_password = "your_mqtt_password_here"

# Grafana
grafana_admin_user     = "admin"
grafana_admin_password = "your_grafana_password_here"

# Telegram (opsional, kosongkan jika belum ada)
telegram_bot_token_iot    = ""
telegram_chat_id_iot      = ""
telegram_bot_token_server = ""
telegram_chat_id_server   = ""
