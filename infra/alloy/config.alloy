// ============================================================
// config.alloy
// Grafana Alloy Configuration for IoT Big Data Nodes
// ============================================================

// ------------------------------------------------------------
// 1. EXPORTER INTEGRATIONS (Data Collectors)
// ------------------------------------------------------------

// Integration to collect host system metrics (CPU, RAM, Disk, Network)
prometheus.exporter.unix "node_metrics" {
  // Use default configuration
}

// Postgres Exporter integration on database nodes (datalayer-1 / datalayer-2)
// ENABLE ONLY ON DATABASE SERVERS (Uncomment lines below)
//
// prometheus.exporter.postgres "postgres_metrics" {
//   # Configure host (localhost), port (5432), and database name (staging_iot_db or iot_db)
//   data_source_names = ["postgresql://kagebyo:kagebyo126x@localhost:5432/staging_iot_db?sslmode=disable"]
// }


// ------------------------------------------------------------
// 2. SCRAPE JOBS (Exporter Scraping & Instance Label Relabeling)
// ------------------------------------------------------------

// Relabel component for explicit instance naming instead of default localhost
prometheus.relabel "rename_instance" {
  forward_to = [prometheus.remote_write.prometheus_server.receiver]
  rule {
    action       = "replace"
    target_label = "instance"
    // SET MATCHING HOST NAME: "applayer-1", "datalayer-1", or "datalayer-2"
    replacement  = "applayer-1"
  }
}

// Scrape host system metrics
prometheus.scrape "scrape_node" {
  targets    = prometheus.exporter.unix.node_metrics.targets
  forward_to = [prometheus.relabel.rename_instance.receiver]
}

// Scrape Postgres database metrics (Enable only on database nodes)
//
// prometheus.scrape "scrape_postgres" {
//   targets    = prometheus.exporter.postgres.postgres_metrics.targets
//   forward_to = [prometheus.relabel.rename_instance.receiver]
// }


// ------------------------------------------------------------
// 3. REMOTE WRITE (Centralized forwarder to Prometheus on applayer-1)
// ------------------------------------------------------------
prometheus.remote_write "prometheus_server" {
  endpoint {
    // Private IP address of applayer-1 Prometheus server (match target environment)
    // Staging: http://10.1.1.208:9090/api/v1/write
    // Production: http://10.0.1.127:9090/api/v1/write
    url = "http://10.1.1.208:9090/api/v1/write"
  }
}
