# =============================================================
# .env.example — copy to .env and configure
# =============================================================

# PostgreSQL / TimescaleDB
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Read replica (datalayer-2) - For Grafana dashboard query (read-only)
POSTGRES_HOST_REPLICA=

# MQTT
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=
MQTT_TOPIC_PREFIX=
MQTT_USER=
MQTT_PASSWORD=

# Grafana
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# AWS S3
AWS_REGION=
S3_BUCKET=

# Local Development Only with MinIO!!! (Leave these empty on production or staging)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# Spark
SPARK_MASTER_URL=

# Telegram Alerting
TELEGRAM_BOT_TOKEN_IOT=
TELEGRAM_CHAT_ID_IOT=
TELEGRAM_BOT_TOKEN_SERVER=
TELEGRAM_CHAT_ID_SERVER=

# Ephemeral Spark Worker (for run_with_worker.sh)
WORKER_SUBNET_ID=
WORKER_SG_ID=
WORKER_IAM_PROFILE=

# Logging
LOG_LEVEL=