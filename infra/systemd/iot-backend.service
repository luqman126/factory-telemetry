[Unit]
Description=IoT Big Data Backend (FastAPI + MQTT consumer)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/iot-bigdata-project/backend
EnvironmentFile=/home/ec2-user/iot-bigdata-project/infra/.env
ExecStart=/home/ec2-user/iot-bigdata-project/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
