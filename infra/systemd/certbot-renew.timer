[Unit]
Description=Run certbot renew twice daily (Let's Encrypt best practice)

[Timer]
# Run at 00:00 and 12:00 with random jitter to prevent synchronized load
# against Let's Encrypt servers across multiple clients
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
