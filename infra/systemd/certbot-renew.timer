[Unit]
Description=Run certbot renew dua kali sehari (Let's Encrypt best practice)

[Timer]
# Jalankan jam 00:00 dan 12:00 dengan random delay supaya tidak semua
# client hit Let's Encrypt di waktu bersamaan
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=3600
Persistent=true

[Install]
WantedBy=timers.target
